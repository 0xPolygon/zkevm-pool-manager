go env -w GONOPROXY=gitlab.okg.com && GOPROXY=goproxy.okg.com && go env -w GOPRIVATE=gitlab.okg.com && git config --global url."https://gitlab-ci-token:${CI_JOB_TOKEN}@gitlab.okg.com/".insteadOf https://gitlab.okg.com/

# 完全移除 kms-bridge 依赖
go mod edit -droprequire gitlab.okg.com/okchain/kms-bridge

# 移除相关 replace 指令
go mod edit -dropreplace gitlab.okg.com/okchain/kms-bridge
go mod edit -dropreplace gitlab.okg.com/okcoin-commons/ok-kms-go-client

# 确保其他依赖正确
go mod tidy && go mod download && go mod verify

echo "finish replace..."

go install github.com/gobuffalo/packr/v2/packr2@latest

cd db && packr2

cd ..

# 创建完全自包含的初始化代码
echo "Injecting inline KMS implementation..."
echo 'package main

import (
    "github.com/okx/kms-interface/kms"
    realkms "gitlab.okg.com/okcoin-commons/ok-kms-go-client/kms"
)

// internalKMSBridge is a direct inline implementation
// that doesn't require external kms-bridge repository
type internalKMSBridge struct{}

func (b *internalKMSBridge) Init() error {
    return realkms.Init()
}

func (b *internalKMSBridge) GetAwsSecretValue(key string) (string, error) {
    return realkms.GetAwsSecretValue(key)
}

func (b *internalKMSBridge) GetAwsSecretData() map[string]error {
    return realkms.GetAwsSecretData()
}

// init sets up the real KMS implementation at application startup
func init() {
    // Set up the real KMS implementation
    kms.Provider = &internalKMSBridge{}
}' > cmd/internal_init.go

# 构建二进制文件
make build

# 清理临时文件
rm cmd/internal_init.go

echo "finish build..."